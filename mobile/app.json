{
  "expo": {
    "name": "Bakers Math",
    "slug": "bakers-math",
    "scheme": "bakersmath",
    "version": "1.0.0",
    "description": "Baker's percentages, guided bakes with step timers, and a bake log with photos. Works offline and syncs with your own Bakers Math server.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF6F0",
    "primaryColor": "#A8581C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bakersmath.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Bakers Math connects to your Bakers Math server on your home network."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bakersmath.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6F0"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-video",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A8581C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bakers Math uses your photo library so you can add photos and videos to a bake.",
          "cameraPermission": "Bakers Math uses the camera so you can take photos and videos of your bakes.",
          "microphonePermission": "Bakers Math uses the microphone to record sound with videos of your bakes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
