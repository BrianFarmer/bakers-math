# Copy to .env. docker compose reads it automatically.
PORT=3000
DATABASE_URL=postgres://bakers:bakers@localhost:5432/bakers_math
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Object storage (MinIO locally, S3 later)
S3_ENDPOINT=http://localhost:9000
# Address the phone uses to reach MinIO for presigned uploads/downloads.
# Set this to your computer's LAN address, e.g. http://192.168.1.20:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bakers-math-media
S3_ACCESS_KEY=bakers
S3_SECRET_KEY=bakers-secret

# Link the password reset email points at (the app opens it)
PASSWORD_RESET_URL=bakersmath://reset-password
